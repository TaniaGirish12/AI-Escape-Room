# Copy this file to ".env" and fill in your own key:
#     cp .env.example .env
# The real .env file is listed in .gitignore and must never be committed.

# Free Gemini API key - create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: which Gemini model to use (must be available on the free tier).
# Run "python check_setup.py" to see the models your key can use.
GEMINI_MODEL=gemini-3.6-flash
