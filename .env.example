# Copy this file to ".env" and fill in your own key:
#     cp .env.example .env
# The real .env file is listed in .gitignore and must never be committed.

# Free Gemini API key - create one at https://aistudio.google.com/apikey
GEMINI_API_KEY=your_api_key_here

# Optional: which Gemini model to use (must be available on the free tier).
# Run "python check_setup.py" to see the models your key can use.
GEMINI_MODEL=gemini-3.6-flash

# Optional (Version 2): models to try, in order, when the main model is busy or
# has used up its free-tier quota (each model has its own quota).
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite,gemini-2.5-flash-lite
